<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lockscreen Translate" android:textSize="22sp" android:textStyle="bold"
            android:paddingBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proxy URL"/>
        <EditText android:id="@+id/proxyUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shared token" android:paddingTop="12dp"/>
        <EditText android:id="@+id/authToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1"/>
        <Button android:id="@+id/save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Save" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/open" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Open Translator" android:layout_marginTop="8dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22ffffff" android:layout_marginTop="28dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lock-screen launch" android:textStyle="bold"
            android:paddingTop="16dp" android:paddingBottom="4dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/launchNotif"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Show a lock-screen launch button (notification)"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Puts a 譯 Translate button on your lock screen — one tap opens it, and keeps your power menu. (Also: swipe-down Quick Settings has a Translate tile.)"
            android:textSize="12sp" android:textColor="#9aa0a6" android:paddingTop="10dp"/>
    </LinearLayout>
</ScrollView>
